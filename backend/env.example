# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bookshelf_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API Keys
# LLM Provider Configuration
# Choose provider: "openai" (paid), "groq" (FREE - Recommended!), "huggingface" (FREE), or "together" (FREE)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant  # Model name depends on provider

# OpenAI (paid) - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Groq (FREE tier - Recommended!)
# Get free API key from https://console.groq.com
# Models: llama-3.1-8b-instant (fast), llama-3.1-70b-versatile (better quality)
GROQ_API_KEY=your-groq-api-key

# Hugging Face (FREE tier available)
# Get from https://huggingface.co/settings/tokens (optional for public models)
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Together AI (FREE tier available)
# Get from https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your-together-api-key

# Google Books API (Optional - get from https://console.cloud.google.com/apis/credentials)
# Free tier: 1,000,000 requests/day with API key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ⚠️ Goodreads API is DEPRECATED (no new keys issued since Dec 2020)
GOODREADS_API_KEY=your-goodreads-api-key
GOODREADS_API_SECRET=your-goodreads-api-secret

# App Settings
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

